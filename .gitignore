# Rust & Tauri
target/
# Cargo.lock is committed on purpose (this is an application).
# Generated by tauri-build on every build.
**/gen/schemas/
apps/tauri/src-tauri/permissions/autogenerated/
apps/tauri/plugins/*/permissions/autogenerated/
# Written by Android Studio when it opens the generated Android project.
apps/tauri/src-tauri/gen/android/.idea/
apps/tauri/src-tauri/gen/android/gradle/gradle-daemon-jvm.properties
# Downloaded sidecar binaries (go2rtc)
apps/tauri/binaries/

# Frontend
web/node_modules/
web/dist/
apps/tauri/node_modules/
.pnpm-store/

# Real configs and secrets (NEVER commit)
config.json
dashboard.json
.vesta/
*.p8
*.p12
*.mobileprovision
*.keystore
*.jks
keystore.properties
local.properties
.env
.env.*

# macOS
.DS_Store

# Claude Code: agent worktrees and personal settings
.claude/worktrees/
.claude/settings.local.json
