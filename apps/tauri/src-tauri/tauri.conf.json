{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VESTA",
  "version": "0.1.0",
  "identifier": "com.usevesta.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../web dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../../web build",
    "frontendDist": "../../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Smart home wall panel",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
