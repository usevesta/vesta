{
  "schema_version": 1,
  "theme": {
    "preset": "glass-dark",
    "auto_dark_mode": true,
    "touch_scale": "large"
  },
  "kiosk": {
    "screensaver_timeout_sec": 120,
    "wake_on": [
      {
        "target": "front_doorbell/main",
        "event": "doorbell.pressed"
      },
      {
        "target": "front_doorbell/main",
        "event": "occupancy.detected"
      }
    ]
  },
  "doorbell_overlay": {
    "doorbell_target": "front_doorbell/main",
    "camera_target": "front_doorbell/main",
    "open_target": "front_door_strike/main",
    "auto_dismiss_sec": 45
  },
  "pages": [
    {
      "id": "home",
      "title": "Home",
      "icon": "home",
      "grid_columns": 4,
      "widgets": [
        {
          "type": "clock-weather",
          "col_span": 2,
          "row_span": 1
        },
        {
          "type": "door-button",
          "target": "front_door_strike/main",
          "col_span": 2,
          "row_span": 1,
          "props": {
            "label": "Front Door"
          }
        },
        {
          "type": "camera-preview",
          "target": "front_doorbell/main",
          "col_span": 2,
          "row_span": 2,
          "props": {
            "live_webrtc": true
          }
        },
        {
          "type": "outlet-control",
          "target": "hall_lamp/main",
          "col_span": 2,
          "row_span": 1,
          "props": {
            "label": "Hall Lamp"
          }
        },
        {
          "type": "robot-vacuum",
          "target": "robot_vacuum/main",
          "col_span": 2,
          "row_span": 1
        }
      ]
    }
  ]
}
